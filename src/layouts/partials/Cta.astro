---
import config from "@/config/config.json";
import { markdownify } from "@/lib/utils/textConverter";

const {
  site: { logo_text },
  call_to_action: {
    title,
    button: { label, link },
  },
} = config;
---

<section class="px-5 py-20 xl:py-[120px]">
  <div class="container">
    <div
      class="bg-gradient rounded-b-[80px] rounded-t-[20px] px-[30px] py-16 text-center lg:py-20"
    >
      <div class="mx-auto max-w-4xl">
        <p class="mb-3 text-xl font-bold text-white/90">{logo_text}</p>
        <h2 class="h1 text-white" set:html={markdownify(title)} />
        <a class="btn btn-white mt-8 font-bold !font-bold" href={link}>{label}</a>
      </div>
    </div>
  </div>
</section>
