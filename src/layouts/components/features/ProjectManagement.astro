---
import { markdownify } from "@/lib/utils/textConverter";

const {
  features: {
    project_management: {
      title,
      content,
    },
  },
} = Astro.props;
---

<section class="section features pb-0">
  <div class="container">
    <div class="row">
      <div class="mx-auto text-center lg:col-7">
        <h2 set:html={markdownify(title)} />
        <p class="mt-4" set:html={markdownify(content)} />
      </div>
    </div>
  </div>
</section>
