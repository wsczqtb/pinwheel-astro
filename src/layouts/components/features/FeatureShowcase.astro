---
import { markdownify } from "@/lib/utils/textConverter";

const { features } = Astro.props;
const showcase = features.feature_showcase;
---

{showcase && (
  <section class="section pt-0">
    <div class="container">
      {showcase.map((item, index) => (
        <div
          class={`row items-center ${index > 0 ? "mt-20" : ""}`}
        >
          {/* 图片列：奇数项在右，偶数项在左 */}
          <div class={`lg:col-6 ${index % 2 === 0 ? "lg:order-1" : "lg:order-2"}`}>
            <div class="relative">
              <img
                class="w-full rounded-xl object-contain shadow-lg"
                src={item.image}
                alt={item.title}
              />
            </div>
          </div>

          {/* 文案列 */}
          <div
            class={`mt-8 lg:col-6 lg:mt-0 ${index % 2 === 0 ? "lg:order-2 lg:pl-12" : "lg:order-1 lg:pr-12"}`}
          >
            <span class="text-sm font-semibold uppercase tracking-wider text-primary">
              {item.subtitle}
            </span>
            <h2 class="mt-3 text-3xl font-bold lg:text-4xl" set:html={markdownify(item.title)} />
            <p class="mt-4 text-text-dark" set:html={markdownify(item.description)} />

            <div class="mt-6 grid gap-4 sm:grid-cols-2">
              {item.features.map((f) => (
                <div class="rounded-lg bg-white p-4 shadow-md">
                  <h3 class="text-lg font-semibold">{f.title}</h3>
                  <p class="mt-2 text-sm text-text-dark">{f.content}</p>
                </div>
              ))}
            </div>

            {item.button && (
              <div class="mt-8">
                <a class="btn btn-primary" href={item.button.link}>
                  {item.button.label}
                </a>
              </div>
            )}
          </div>
        </div>
      ))}
    </div>
  </section>
)}
