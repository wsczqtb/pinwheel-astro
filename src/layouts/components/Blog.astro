---
import dateFormat from "@/lib/utils/dateFormat";
import type { BlogPostSummary } from "@/lib/blogPosts";

type Props = {
  posts: BlogPostSummary[];
};
const { posts } = Astro.props;
---

<div class="row">
  {
    posts.map((item) => (
      <div class="mb-8 md:col-6 lg:col-4">
        <div class="card">
          {item.data.image ? (
            <img
              class="card-img aspect-video"
              width={335}
              height={210}
              src={item.data.image}
              alt={item.data.title}
              loading="lazy"
            />
          ) : (
            <div
              class="card-img flex aspect-video items-center justify-center bg-light"
              aria-hidden="true"
            >
              <img class="h-16 w-auto opacity-60" src="/images/logo.webp" alt="" />
            </div>
          )}
          <div class="card-content">
            <h3 class="h4 card-title">
              <a href={`/blog/${item.id}`}>{item.data.title}</a>
            </h3>

            <div class="card-footer mt-6 flex space-x-4">
              <span class="inline-flex items-center text-xs text-[#666]">
                <svg
                  class="mr-1.5"
                  width="14"
                  height="16"
                  viewBox="0 0 14 16"
                  fill="none"
                  xmlns="http://www.w3.org/2000/svg"
                >
                  <path
                    d="M12.5 2H11V0.375C11 0.16875 10.8313 0 10.625 0H9.375C9.16875 0 9 0.16875 9 0.375V2H5V0.375C5 0.16875 4.83125 0 4.625 0H3.375C3.16875 0 3 0.16875 3 0.375V2H1.5C0.671875 2 0 2.67188 0 3.5V14.5C0 15.3281 0.671875 16 1.5 16H12.5C13.3281 16 14 15.3281 14 14.5V3.5C14 2.67188 13.3281 2 12.5 2ZM12.3125 14.5H1.6875C1.58438 14.5 1.5 14.4156 1.5 14.3125V5H12.5V14.3125C12.5 14.4156 12.4156 14.5 12.3125 14.5Z"
                    fill="#939393"
                  />
                </svg>
                {dateFormat(item.data.date!)}
              </span>
            </div>
          </div>
        </div>
      </div>
    ))
  }
</div>
