---
import PageHeader from "@/components/PageHeader.astro";
import config from "@/config/config.json";
import Base from "@/layouts/Base.astro";
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import { getEntry } from "astro:content";

const entry = (await getEntry("contact", "-index")) as CollectionEntry<"contact">;
const contact = entry.data;
const page_data = {
  ...contact,
  content: entry.body,
};

const companyName = "深圳市灵犀百运科技有限公司";
const address = "深圳市龙岗区园山街道大运软件小镇35栋2楼";
const email = config.params.email;
---

<Base
  title={contact.title}
  meta_title={contact.meta_title}
  description={contact.description}
  image={contact.image}
>
  <section class="page-hero pb-6 pt-16">
    <div class="container">
      <PageHeader page_data={page_data} />
    </div>
  </section>

  <section class="section pt-0">
    <div class="container">
      <div class="row items-center">
        {/* 左列：图片 */}
        <div class="md:col-6">
          <img
            src="/images/contact-img.png"
            alt="联系我们"
            class="w-full rounded-xl object-cover"
          />
        </div>

        {/* 右列：公司信息 */}
        <div class="mt-10 md:col-6 md:mt-0 md:pl-12">
          <h3 class="h4 font-bold text-text-dark">{companyName}</h3>

          <p class="mt-6">公司地点：深圳市龙岗区园山街道大运软件小镇35栋2楼</p>
          <p class="mt-3">邮箱：service@9810yun.com</p>

          {/* 二维码 */}
          <div class="mt-8">
            <img
              src="/images/qrcode.png"
              alt="扫码关注"
              class="w-32 rounded-lg border border-border p-2"
            />
            <p class="mt-2 text-sm text-text">扫码关注</p>
          </div>
        </div>
      </div>
    </div>
  </section>
</Base>
